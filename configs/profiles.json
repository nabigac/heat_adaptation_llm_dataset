{
  "schema_version": 1,
  "document_tools": {
    "ocr_enabled": true,
    "ocr_engine": "easyocr",
    "ocr_language": "en",
    "image_render_dpi": 150,
    "tool_timeout_seconds": 120
  },
  "profiles": [
    {
      "name": "inkling2_small_hf_extractor",
      "stage": "extractor",
      "model": {
        "name": "thinkingmachines/Inkling-2-Small",
        "execution_mode": "hosted_api",
        "endpoint": "https://router.huggingface.co/v1",
        "api_service": "huggingface",
        "provider": "deepinfra"
      },
      "generation": {
        "temperature": null,
        "top_p": null,
        "seed": null,
        "max_output_tokens": 32768
      },
      "context_limit": 1048576,
      "prompt_paths": [
        "prompts/shared_coding.md",
        "prompts/field_definitions.md",
        "prompts/extractor.md"
      ],
      "max_tool_calls": 10,
      "model_timeout_seconds": 1800,
      "image_input_enabled": false
    }
  ]
}
