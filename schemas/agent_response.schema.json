{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heat-adaptation:agent-response",
  "title": "Heat adaptation agent final response",
  "description": "Model answer containing plan information, actions, and review issues, defined in DESIGN.md appendices A-D.",
  "$comment": "Load the content schema into a local schema registry. Python additionally checks IDs, links, page ranges, one issue per affected record, and issue-stage consistency. A resolved status is an agent claim, not expert confirmation.",
  "type": "object",
  "required": [
    "content",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "content": {
      "$ref": "urn:heat-adaptation:content"
    },
    "review": {
      "type": "object",
      "required": [
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/issue"
              },
              {
                "properties": {
                  "resolved_by": {
                    "enum": [
                      "extractor",
                      "verifier",
                      null
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "issue": {
      "type": "object",
      "required": [
        "issue_id",
        "related_action_id",
        "issue_description",
        "issue_origin",
        "issue_status",
        "resolved_by",
        "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/text"
        },
        "related_action_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        },
        "issue_description": {
          "$ref": "#/$defs/text"
        },
        "issue_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "unclear_meaning",
            "conflicting_evidence",
            "source_issue",
            "extraction_process_issue",
            "no_records_found",
            null
          ]
        },
        "issue_origin": {
          "type": "string",
          "enum": [
            "extractor",
            "verifier"
          ]
        },
        "issue_status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolved_by": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "extractor",
            "verifier",
            "expert",
            null
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "if": {
        "properties": {
          "issue_status": {
            "const": "open"
          }
        },
        "required": [
          "issue_status"
        ]
      },
      "then": {
        "properties": {
          "resolved_by": {
            "type": "null"
          },
          "resolution": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "resolved_by": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          }
        }
      }
    }
  }
}
