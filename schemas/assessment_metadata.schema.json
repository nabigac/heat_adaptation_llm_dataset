{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development assessment inputs",
  "description": "Exact selected runs and frozen reference for manual CSV review. Creation records no expert judgments and calculates no metrics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assessment_id", "plan_id", "purpose", "created_at", "reviewers", "notes", "reference", "source", "runs", "included_attempts", "instructions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "assessment_id": {"type": "string", "pattern": "^assessment_[0-9]+$"},
    "plan_id": {"$ref": "#/$defs/text"},
    "purpose": {"const": "development"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "(?:[Zz]|\\+00:00)$"},
    "reviewers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "notes": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "freeze_path", "freeze_sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"},
        "freeze_path": {"$ref": "#/$defs/text"}, "freeze_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["preparation_path", "fingerprint", "document_sha256", "page_count"],
      "properties": {
        "preparation_path": {"$ref": "#/$defs/text"},
        "fingerprint": {"$ref": "#/$defs/sha256"}, "document_sha256": {"$ref": "#/$defs/sha256"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "runs": {
      "type": "object", "additionalProperties": false, "required": ["E", "E+V", "C"],
      "properties": {"E": {"$ref": "#/$defs/run"}, "E+V": {"$ref": "#/$defs/run"}, "C": {"$ref": "#/$defs/run"}}
    },
    "included_attempts": {"type": "null", "description": "Failure-reporting scope is pending, not a finding of zero failures."},
    "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "record_path", "record_sha256", "selected_via"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^run_(extract|verify|collaboration)_[0-9]+$"},
        "record_path": {"$ref": "#/$defs/text"}, "record_sha256": {"$ref": "#/$defs/sha256"},
        "selected_via": {"enum": ["explicit", "latest_successful", "verifier_link"]}
      }
    }
  }
}
