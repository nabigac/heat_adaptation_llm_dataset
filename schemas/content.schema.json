{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heat-adaptation:content",
  "title": "Heat adaptation extracted content",
  "description": "Plan information and grouped heat adaptation actions, defined in DESIGN.md appendices A-C.",
  "$comment": "Python validates action IDs, evidence pages, issue links, and required review flags. Experts assess source meaning and completeness.",
  "type": "object",
  "required": [
    "plan_info",
    "plan_actions"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_info": {
      "$ref": "#/$defs/plan_info"
    },
    "plan_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S",
      "description": "Nonblank text, preserved without trimming or rewriting."
    },
    "nullable_text": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    },
    "record_id": {
      "$ref": "#/$defs/text",
      "description": "A stable local action ID, such as action_0001."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "quote",
          "page_numbers"
        ],
        "additionalProperties": false,
        "properties": {
          "quote": {
            "$ref": "#/$defs/text",
            "description": "One exact continuous passage. Separate passages use separate evidence objects."
          },
          "page_numbers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Physical PDF positions starting at 1, regardless of printed labels."
          }
        }
      }
    },
    "plan_info": {
      "type": "object",
      "required": [
        "plan_title",
        "jurisdiction_name",
        "country",
        "plan_scale",
        "plan_type",
        "publication_year",
        "lead_agencies",
        "source_url",
        "date_accessed",
        "language"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_title": {
          "$ref": "#/$defs/nullable_text"
        },
        "jurisdiction_name": {
          "$ref": "#/$defs/nullable_text"
        },
        "country": {
          "$ref": "#/$defs/nullable_text"
        },
        "plan_scale": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "city",
            "county",
            "region",
            "state",
            "country",
            null
          ]
        },
        "plan_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "heat_specific_plan",
            "broader_climate_plan",
            null
          ]
        },
        "publication_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "lead_agencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "source_url": {
          "$ref": "#/$defs/text",
          "description": "Copy the source URL from collection metadata; run setup must check that copy against its saved input."
        },
        "date_accessed": {
          "type": "string",
          "format": "date"
        },
        "language": {
          "type": "string",
          "const": "English"
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "action_id",
        "action",
        "action_type",
        "action_status",
        "action_location",
        "action_recipient",
        "action_cost",
        "action_benefit",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "$ref": "#/$defs/record_id"
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "action_type": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "infrastructural",
              "institutional",
              "behavioral/cultural",
              "nature-based"
            ]
          }
        },
        "action_status": {
          "type": "string",
          "enum": [
            "planned",
            "underway",
            "completed",
            "unspecified"
          ]
        },
        "action_location": {
          "$ref": "#/$defs/nullable_text"
        },
        "action_recipient": {
          "$ref": "#/$defs/nullable_text"
        },
        "action_cost": {
          "$ref": "#/$defs/nullable_text"
        },
        "action_benefit": {
          "$ref": "#/$defs/nullable_text"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  }
}
