{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heat-adaptation:curated-dataset",
  "title": "Expert-curated plan dataset",
  "type": "object",
  "required": [
    "plan_data",
    "plan_issues"
  ],
  "additionalProperties": false,
  "properties": {
    "plan_data": {
      "$ref": "urn:heat-adaptation:plan-data"
    },
    "plan_issues": {
      "type": "object",
      "required": [
        "issues"
      ],
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:heat-adaptation:agent-response#/$defs/issue"
          }
        }
      }
    }
  }
}
