{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heat-adaptation:expert-reference",
  "title": "Expert reference form",
  "description": "One independent expert reference per plan, with guided draft records and optional expert issues, used for E, E+V, and C.",
  "$comment": "This defines field structure only. Python checks registered plan/source links, unique action IDs, and upper PDF page bounds. Experts establish source support and completeness.",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "plan_data"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Version of the expert reference file format."
    },
    "plan_id": {
      "$ref": "#/$defs/text",
      "description": "Registered plan ID; checked against project records by Python."
    },
    "id_counters": {
      "type": "object",
      "required": ["action", "issue"],
      "additionalProperties": false,
      "properties": {
        "action": {"type": "integer", "minimum": 0},
        "issue": {"type": "integer", "minimum": 0}
      },
      "description": "Highest numbered IDs allocated by the editor; never decrease after deletion. Older forms acquire counters on their next edit."
    },
    "plan_data": {
      "$ref": "urn:heat-adaptation:plan-data"
    },
    "instructions": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"}
    },
    "plan_issues": {
      "type": "object",
      "required": ["issues"],
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "array",
          "items": {"$ref": "#/$defs/expert_issue"}
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "expert_issue": {
      "type": "object",
      "required": [
        "issue_id", "related_action_id", "issue_description", "issue_origin",
        "issue_status", "resolved_by", "resolution"
      ],
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "$ref": "urn:heat-adaptation:agent-response#/$defs/issue/properties/issue_id"
        },
        "related_action_id": {
          "$ref": "urn:heat-adaptation:agent-response#/$defs/issue/properties/related_action_id"
        },
        "issue_description": {
          "$ref": "urn:heat-adaptation:agent-response#/$defs/issue/properties/issue_description"
        },
        "issue_type": {
          "$ref": "urn:heat-adaptation:agent-response#/$defs/issue/properties/issue_type"
        },
        "issue_origin": {"type": "string", "const": "expert"},
        "issue_status": {
          "$ref": "urn:heat-adaptation:agent-response#/$defs/issue/properties/issue_status"
        },
        "resolved_by": {"type": ["string", "null"], "enum": ["expert", null]},
        "resolution": {
          "$ref": "urn:heat-adaptation:agent-response#/$defs/issue/properties/resolution"
        }
      },
      "if": {"$ref": "urn:heat-adaptation:agent-response#/$defs/issue/if"},
      "then": {"$ref": "urn:heat-adaptation:agent-response#/$defs/issue/then"},
      "else": {"$ref": "urn:heat-adaptation:agent-response#/$defs/issue/else"}
    }
  }
}
