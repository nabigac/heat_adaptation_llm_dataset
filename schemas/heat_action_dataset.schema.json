{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heat-adaptation:heat-action-dataset",
  "title": "Combined heat adaptation action dataset",
  "description": "Clean plan metadata/actions with local plan identities. Review history and provenance remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plans"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "plan_id",
          "metadata",
          "actions"
        ],
        "properties": {
          "plan_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "metadata": {
            "$ref": "urn:heat-adaptation:plan-data#/properties/metadata"
          },
          "actions": {
            "$ref": "urn:heat-adaptation:plan-data#/properties/actions"
          }
        }
      }
    }
  }
}
