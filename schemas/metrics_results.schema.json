{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-plan development assessment metrics",
  "description": "Calculated from exact validated inputs. Scientific correctness depends on expert judgments. Unavailable values remain null.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "method_version", "calculation_id", "plan_id", "assessment_id", "purpose", "created_at", "assessment", "code_files", "review", "configurations", "paired_changes", "verifier_resolutions", "failure_reporting", "summary"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "method_version": {"const": 1, "type": "integer"},
    "calculation_id": {"type": "string", "pattern": "^metrics_[0-9]+$"},
    "plan_id": {"$ref": "#/$defs/text"},
    "assessment_id": {"type": "string", "pattern": "^assessment_[0-9]+$"},
    "purpose": {"const": "development"},
    "created_at": {"type": "string", "format": "date-time", "pattern": "(?:[Zz]|\\+00:00)$"},
    "assessment": {
      "type": "object", "additionalProperties": false, "required": ["path", "files", "metadata"],
      "properties": {
        "path": {"$ref": "#/$defs/text"},
        "metadata": {"$ref": "urn:heat-adaptation:assessment-metadata"},
        "files": {
          "type": "object", "additionalProperties": false,
          "required": ["metadata.json", "action_scores.csv", "output_review.csv", "verifier_resolutions.csv"],
          "properties": {
            "metadata.json": {"$ref": "#/$defs/sha256"}, "action_scores.csv": {"$ref": "#/$defs/sha256"},
            "output_review.csv": {"$ref": "#/$defs/sha256"}, "verifier_resolutions.csv": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "code_files": {
      "type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"},
      "propertyNames": {"type": "string", "pattern": "^(src/[a-z_]+\\.py|schemas/[a-z_]+\\.schema\\.json|pyproject\\.toml|uv\\.lock)$"}
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["complete", "pending", "readiness"],
      "properties": {
        "complete": {"type": "boolean"},
        "pending": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["table", "location", "message", "configuration"],
          "properties": {
            "table": {"enum": ["action_scores.csv", "output_review.csv", "verifier_resolutions.csv"]},
            "location": {"$ref": "#/$defs/text"}, "message": {"$ref": "#/$defs/text"},
            "configuration": {"enum": ["E", "E+V", "C", null]}
          }
        }},
        "readiness": {
          "type": "object", "additionalProperties": false,
          "required": ["reference_actions", "output_support", "output_evidence", "verifier_resolutions"],
          "properties": {
            "reference_actions": {"$ref": "#/$defs/readiness"}, "output_support": {"$ref": "#/$defs/readiness"},
            "output_evidence": {"$ref": "#/$defs/readiness"}, "verifier_resolutions": {"type": "boolean"}
          }
        }
      }
    },
    "configurations": {
      "type": "object", "additionalProperties": false, "required": ["E", "E+V", "C"],
      "properties": {"E": {"$ref": "#/$defs/configuration"}, "E+V": {"$ref": "#/$defs/configuration"}, "C": {"$ref": "#/$defs/configuration"}}
    },
    "paired_changes": {
      "type": "object", "additionalProperties": false, "required": ["E+V_minus_E", "C_minus_E+V"],
      "properties": {
        "E+V_minus_E": {"allOf": [{"$ref": "#/$defs/comparison"}, {"properties": {"before": {"const": "E"}, "after": {"const": "E+V"}}}]},
        "C_minus_E+V": {"allOf": [{"$ref": "#/$defs/comparison"}, {"properties": {"before": {"const": "E+V"}, "after": {"const": "C"}}}]}
      }
    },
    "verifier_resolutions": {"$ref": "#/$defs/measure"},
    "failure_reporting": {
      "type": "object", "additionalProperties": false, "required": ["status", "included_attempts", "counts", "reason"],
      "properties": {
        "status": {"const": "unavailable"}, "included_attempts": {"type": "null"}, "reason": {"$ref": "#/$defs/text"},
        "counts": {"type": "object", "additionalProperties": false, "required": ["E", "V", "C"],
                   "properties": {"E": {"type": "null"}, "V": {"type": "null"}, "C": {"type": "null"}}}
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"const": "summary.csv"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "readiness": {
      "type": "object", "additionalProperties": false, "required": ["E", "E+V", "C"],
      "properties": {"E": {"type": "boolean"}, "E+V": {"type": "boolean"}, "C": {"type": "boolean"}}
    },
    "measure": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit", "status", "reason", "numerator", "denominator"],
      "properties": {
        "value": {"type": ["number", "null"]}, "numerator": {"type": ["number", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "null"], "minimum": 0},
        "unit": {"enum": ["percent", "percentage_points", "activities", "issues", "resolutions", "seconds", "tokens"]},
        "status": {"enum": ["available", "pending", "unavailable", "not_applicable"]},
        "reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "available"}}},
        "then": {"properties": {"value": {"type": "number"}, "reason": {"type": "null"}}},
        "else": {"properties": {"value": {"type": "null"}, "reason": {"$ref": "#/$defs/text"}}}
      }]
    },
    "measures": {
      "type": "object", "additionalProperties": false,
      "required": ["action_score_percentage", "unsupported_action_count", "adequate_evidence_percentage", "open_issue_count", "runtime_seconds", "input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "action_score_percentage": {"$ref": "#/$defs/measure"}, "unsupported_action_count": {"$ref": "#/$defs/measure"},
        "adequate_evidence_percentage": {"$ref": "#/$defs/measure"}, "open_issue_count": {"$ref": "#/$defs/measure"},
        "runtime_seconds": {"$ref": "#/$defs/measure"}, "input_tokens": {"$ref": "#/$defs/measure"},
        "output_tokens": {"$ref": "#/$defs/measure"}, "total_tokens": {"$ref": "#/$defs/measure"}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["reference_action_count", "raw_output_record_count", "candidate_activity_groups", "total_output_activities", "score_distribution", "metrics"],
      "properties": {
        "reference_action_count": {"type": "integer", "minimum": 0},
        "raw_output_record_count": {"type": "integer", "minimum": 0},
        "candidate_activity_groups": {"type": "integer", "minimum": 0},
        "total_output_activities": {"type": ["integer", "null"], "minimum": 0},
        "score_distribution": {"anyOf": [{"type": "null"}, {
          "type": "object", "additionalProperties": false, "required": ["0", "0.5", "1"],
          "properties": {"0": {"type": "integer", "minimum": 0}, "0.5": {"type": "integer", "minimum": 0}, "1": {"type": "integer", "minimum": 0}}
        }]},
        "metrics": {"$ref": "#/$defs/measures"}
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false, "required": ["before", "after", "metrics"],
      "properties": {"before": {"enum": ["E", "E+V"]}, "after": {"enum": ["E+V", "C"]}, "metrics": {"$ref": "#/$defs/measures"}}
    }
  }
}
