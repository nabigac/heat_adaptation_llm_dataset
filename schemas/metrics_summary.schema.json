{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Selected per-plan metric summary",
  "description": "Descriptive study summary with exact result selections and explicit contributing/excluded plans. No scientific judgments are inferred.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "summary_id", "purpose", "method_version", "created_at", "selections", "aggregates", "code_files", "summary"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "summary_id": {"type": "string", "pattern": "^summary_[0-9]+$"},
    "purpose": {"const": "comparison"},
    "method_version": {"type": "integer", "const": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "(?:[Zz]|\\+00:00)$"},
    "selections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["plan_id", "assessment_id", "calculation_id", "result_path", "package_files"],
        "properties": {
          "plan_id": {"$ref": "#/$defs/text"},
          "assessment_id": {"type": "string", "pattern": "^assessment_[0-9]+$"},
          "calculation_id": {"type": "string", "pattern": "^metrics_[0-9]+$"},
          "result_path": {"$ref": "#/$defs/text"},
          "package_files": {
            "type": "object", "minProperties": 1,
            "required": ["results.json", "summary.csv", "assessment_inputs/metadata.json", "assessment_inputs/action_scores.csv", "assessment_inputs/output_review.csv", "assessment_inputs/verifier_resolutions.csv"],
            "additionalProperties": {"$ref": "#/$defs/sha256"},
            "propertyNames": {"type": "string", "pattern": "^(results\\.json|summary\\.csv|assessment_inputs/(metadata\\.json|action_scores\\.csv|output_review\\.csv|verifier_resolutions\\.csv)|code/(src/[a-z_]+\\.py|schemas/[a-z_]+\\.schema\\.json|pyproject\\.toml|uv\\.lock))$"}
          }
        }
      }
    },
    "aggregates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/aggregate"}},
    "code_files": {
      "type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"},
      "propertyNames": {"type": "string", "pattern": "^(src/[a-z_]+\\.py|schemas/[a-z_]+\\.schema\\.json|pyproject\\.toml|uv\\.lock)$"}
    },
    "summary": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {"path": {"const": "summary.csv"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "aggregate": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "configuration", "metric", "aggregation", "value", "unit", "status", "reason", "numerator", "denominator", "contributing_plan_count", "contributing_plans", "excluded_plans"],
      "properties": {
        "scope": {"enum": ["configuration", "paired_change", "verifier_resolution"]},
        "configuration": {"enum": ["E", "E+V", "C", "E+V_minus_E", "C_minus_E+V"]},
        "metric": {"enum": ["action_score_percentage", "unsupported_action_count", "adequate_evidence_percentage", "open_issue_count", "runtime_seconds", "input_tokens", "output_tokens", "total_tokens", "total_output_activities", "expert_confirmed_verifier_resolutions"]},
        "aggregation": {"enum": ["mean", "sum", "confirmed_over_claimed"]},
        "value": {"type": ["number", "null"]},
        "unit": {"enum": ["percent", "percentage_points", "activities", "issues", "resolutions", "seconds", "tokens"]},
        "status": {"enum": ["available", "pending", "unavailable", "not_applicable"]},
        "reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]},
        "numerator": {"type": ["number", "null"], "minimum": 0},
        "denominator": {"type": ["integer", "null"], "minimum": 0},
        "contributing_plan_count": {"type": "integer", "minimum": 0},
        "contributing_plans": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "excluded_plans": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["plan_id", "status", "reason"],
            "properties": {
              "plan_id": {"$ref": "#/$defs/text"},
              "status": {"enum": ["pending", "unavailable", "not_applicable"]}, "reason": {"$ref": "#/$defs/text"}
            }
          }
        }
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "available"}}},
        "then": {"properties": {"value": {"type": "number"}, "reason": {"type": "null"}}},
        "else": {"properties": {"value": {"type": "null"}, "reason": {"$ref": "#/$defs/text"}}}
      }]
    }
  }
}
