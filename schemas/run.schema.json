{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heat-adaptation:run",
  "title": "Heat adaptation run record",
  "description": "One extractor or verifier attempt, including saved run settings, measurements, content, and review, from DESIGN.md Appendix A.",
  "$comment": "Python supplies run metadata and measurements. Load the content and agent-response schemas locally. Python checks finite numbers, timestamp order, paths, role agreement, truncation, and embedded response references. Storage must later resolve saved files and linked runs without rewriting completed work.",
  "type": "object",
  "required": [
    "schema_version", "plan_id", "run_id", "stage", "purpose", "input_run_id",
    "retry_of_run_id", "source_path", "status", "started_at", "ended_at",
    "elapsed_seconds", "settings", "model_calls", "tool_log_path", "content", "review", "error"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "plan_id": {"$ref": "#/$defs/text"},
    "run_id": {"$ref": "#/$defs/text"},
    "stage": {"type": "string", "enum": ["extractor", "verifier"]},
    "purpose": {"type": "string", "enum": ["development", "comparison", "exploratory"]},
    "input_run_id": {"$ref": "#/$defs/nullable_text"},
    "retry_of_run_id": {"$ref": "#/$defs/nullable_text"},
    "source_path": {"$ref": "#/$defs/text"},
    "status": {"type": "string", "enum": ["running", "succeeded", "failed"]},
    "started_at": {"$ref": "#/$defs/utc_timestamp"},
    "ended_at": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/utc_timestamp"}]},
    "elapsed_seconds": {
      "type": ["number", "null"], "minimum": 0,
      "description": "Measured stage duration, or null when unavailable. Do not reconstruct an interrupted run's duration from recovery time."
    },
    "settings": {"$ref": "#/$defs/saved_run_settings"},
    "model_calls": {"type": "array", "items": {"$ref": "#/$defs/model_call"}},
    "tool_log_path": {"$ref": "#/$defs/nullable_text"},
    "content": {"anyOf": [{"type": "null"}, {"$ref": "urn:heat-adaptation:content"}]},
    "review": {"anyOf": [{"type": "null"}, {"$ref": "urn:heat-adaptation:agent-response#/properties/review"}]},
    "error": {"$ref": "#/$defs/nullable_text"}
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "extractor"}}, "required": ["stage"]},
      "then": {"properties": {"input_run_id": {"type": "null"}}},
      "else": {"properties": {"input_run_id": {"type": "string"}}}
    },
    {
      "if": {"properties": {"status": {"const": "running"}}, "required": ["status"]},
      "then": {"properties": {"ended_at": {"type": "null"}, "error": {"type": "null"}}},
      "else": {"properties": {"ended_at": {"type": "string"}}}
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
      "then": {
        "properties": {
          "content": {"type": "object"}, "review": {"type": "object"},
          "error": {"type": "null"}, "model_calls": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"properties": {"error": {"type": "string"}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "nullable_text": {"type": ["string", "null"], "pattern": "\\S"},
    "utc_timestamp": {
      "type": "string", "format": "date-time",
      "pattern": "(?:[Zz]|\\+00:00)$", "not": {"pattern": "\\s"}
    },
    "saved_run_settings": {
      "type": "object",
      "description": "Saved run settings: the complete selected profile, shared document tools, exact ordered prompt texts, and detected environment. Later configuration edits must not change this record.",
      "required": [
        "name", "stage", "model", "generation", "context_limit", "prompt_paths",
        "max_tool_calls", "model_timeout_seconds", "image_input_enabled",
        "document_tools", "prompt_texts", "environment"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "stage": {"type": "string", "enum": ["extractor", "verifier"]},
        "model": {
          "type": "object",
          "required": ["name", "execution_mode", "endpoint", "api_service", "provider"],
          "additionalProperties": false,
          "properties": {
            "name": {"$ref": "#/$defs/text"},
            "execution_mode": {"type": "string", "enum": ["local", "hosted_api"]},
            "endpoint": {"$ref": "#/$defs/text"},
            "api_service": {"$ref": "#/$defs/nullable_text"},
            "provider": {"$ref": "#/$defs/nullable_text"}
          },
          "if": {"properties": {"execution_mode": {"const": "hosted_api"}}, "required": ["execution_mode"]},
          "then": {"properties": {"api_service": {"type": "string"}, "provider": {"type": "string"}}}
        },
        "generation": {
          "type": "object",
          "required": ["temperature", "top_p", "seed", "max_output_tokens"],
          "additionalProperties": false,
          "properties": {
            "temperature": {"type": ["number", "null"], "minimum": 0},
            "top_p": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
            "seed": {"type": ["integer", "null"]},
            "max_output_tokens": {"type": "integer", "minimum": 1}
          }
        },
        "context_limit": {"type": "integer", "minimum": 1},
        "prompt_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "max_tool_calls": {"type": "integer", "minimum": 1},
        "model_timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "image_input_enabled": {"type": "boolean"},
        "document_tools": {
          "type": "object",
          "required": ["ocr_enabled", "ocr_engine", "ocr_language", "image_render_dpi", "tool_timeout_seconds"],
          "additionalProperties": false,
          "properties": {
            "ocr_enabled": {"type": "boolean"},
            "ocr_engine": {"$ref": "#/$defs/nullable_text"},
            "ocr_language": {"$ref": "#/$defs/nullable_text"},
            "image_render_dpi": {"type": "integer", "minimum": 1},
            "tool_timeout_seconds": {"type": "number", "exclusiveMinimum": 0}
          },
          "if": {"properties": {"ocr_enabled": {"const": true}}, "required": ["ocr_enabled"]},
          "then": {"properties": {"ocr_engine": {"type": "string"}, "ocr_language": {"type": "string"}}},
          "else": {"properties": {"ocr_engine": {"type": "null"}, "ocr_language": {"type": "null"}}}
        },
        "prompt_texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "environment": {
          "type": "object",
          "required": [
            "model_revision", "runtime", "runtime_version", "quantization", "hardware",
            "code_commit", "python_version", "model_client_version", "preparation_version",
            "tools_version", "ocr_version", "code_dirty", "model_loaded_at_start"
          ],
          "additionalProperties": false,
          "properties": {
            "model_revision": {"$ref": "#/$defs/nullable_text"},
            "runtime": {"$ref": "#/$defs/nullable_text"},
            "runtime_version": {"$ref": "#/$defs/nullable_text"},
            "quantization": {"$ref": "#/$defs/nullable_text"},
            "hardware": {"$ref": "#/$defs/nullable_text"},
            "code_commit": {"$ref": "#/$defs/nullable_text"},
            "python_version": {"$ref": "#/$defs/nullable_text"},
            "model_client_version": {"$ref": "#/$defs/nullable_text"},
            "preparation_version": {"$ref": "#/$defs/nullable_text"},
            "tools_version": {"$ref": "#/$defs/nullable_text"},
            "ocr_version": {"$ref": "#/$defs/nullable_text"},
            "code_dirty": {"type": "boolean"},
            "model_loaded_at_start": {"type": ["boolean", "null"]}
          }
        }
      }
    },
    "model_call": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "finish_reason", "truncated", "response_path"],
      "additionalProperties": false,
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "finish_reason": {"$ref": "#/$defs/nullable_text"},
        "truncated": {"type": ["boolean", "null"]},
        "response_path": {"$ref": "#/$defs/nullable_text"}
      }
    }
  }
}
