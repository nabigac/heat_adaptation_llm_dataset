{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heat adaptation ordered tool log",
  "description": "Completed tool requests, results, durations, and failures from DESIGN.md Appendix A.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["tool", "arguments", "result", "elapsed_seconds", "error"],
    "additionalProperties": false,
    "properties": {
      "tool": {"type": "string", "pattern": "\\S"},
      "arguments": {"type": "object"},
      "result": {"type": ["object", "null"]},
      "elapsed_seconds": {"type": ["number", "null"], "minimum": 0},
      "error": {"type": ["string", "null"], "pattern": "\\S"}
    }
  }
}
